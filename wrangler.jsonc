{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",

	// Deliberately NOT renamed with the move to Italy Way Transfers.
	//
	// A Worker name is an identity, not a label: deploying under a new one
	// creates a second Worker rather than renaming this one. The D1 binding
	// below would follow, because it names the database by id — but the nine
	// secrets would not. CRM_ADMIN_USERNAME, CRM_ADMIN_PASSWORD_HASH,
	// CRM_SESSION_SECRET, CRM_ALLOWED_EMAILS, CF_ACCESS_AUD,
	// CF_ACCESS_TEAM_DOMAIN, RESEND_API_KEY, LEAD_ADMIN_EMAIL and
	// LEAD_FROM_EMAIL all live on the Worker, so a rename logs every CRM user
	// out permanently and silences every lead email until all nine are set
	// again by hand.
	//
	// The name is invisible to visitors; the hostname in `routes` is what
	// carries the brand, and that one did change. Renaming buys nothing and
	// costs the CRM.
	"name": "private-transfers-across-italy",
	"compatibility_date": "2026-10-29",

	// nodejs_compat is required for one import: lib/quote/idempotency.ts hashes
	// the submission with node:crypto. It also covered @supabase/ssr until that
	// was removed, so this is now a narrower dependency than it looks.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// The production hostname. `custom_domain: true` makes Cloudflare create
	// and own the proxied DNS record for the apex, which is also what puts the
	// request behind Cloudflare Access: the Access application is scoped to
	// `<apex>/crm`, so it can only intercept traffic arriving on this
	// hostname. Access does NOT cover the workers.dev URL, which is why /crm
	// there refuses everyone.
	//
	// Two things must be true on the account before a deploy with this value
	// succeeds: italywaytransfers.com is an active zone, and the old apex no
	// longer claims this Worker. The Access application is per-hostname, so it
	// has to be recreated against the new apex as well — until it is, /crm is
	// reachable by anyone who knows the path.
	"routes": [
		{
			"pattern": "italywaytransfers.com",
			"custom_domain": true
		}
	],

	// Off. It was on temporarily while the custom domain was being proved, and
	// the apex is now confirmed serving this Worker, so the second origin has
	// done its job.
	//
	// It mattered because *.workers.dev published the entire public site at a
	// second address: every page canonicals to the apex, so nothing there
	// claimed to be the original, but it was still a live URL nobody intended
	// to publish — and one that Cloudflare Access never covered, which is why
	// /crm on it refused everyone.
	//
	// Turning it off does not touch `routes` above. The custom domain is a
	// separate trigger with its own DNS record, and withdrawing the
	// workers.dev subdomain leaves it untouched.
	"workers_dev": false,

	"services": [
		{
			// Self-reference, used by OpenNext for cache purging. The service name
			// must equal the Worker name above or the deploy fails to resolve it.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "private-transfers-across-italy"
		}
	],

	// The D1 database that already exists on the account. Inspected
	// 29 October 2026: 0 tables, so the migration in
	// migrations/0001_create_leads.sql creates rather than alters.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "italytransfers",
			"database_id": "9f31329f-0b8e-4abd-8b06-9d82f6f6cef6"
		}
	]

	// No "images" binding. Cloudflare Images transformations are billable
	// beyond the free allowance and have not been approved, so next/image runs
	// unoptimized instead — see the `images` block in next.config.ts for the
	// trade-off. Add the binding back here, and remove `unoptimized`, to turn
	// optimization on.

	// No R2 bucket and no KV namespace. The incremental cache is served from
	// the Worker's own assets; see open-next.config.ts.
}
