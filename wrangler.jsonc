{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",

	// Renamed with the move to Italy Way Transfers, on 19 November 2026.
	//
	// This reverses an earlier decision recorded here, and the reasoning is
	// worth keeping because the earlier reasoning was sound at the time. A
	// Worker name is an identity, not a label: deploying under a new one
	// creates a second Worker rather than renaming the old one, and secrets
	// live on the Worker, so a rename silently abandons them. On the previous
	// account nine secrets were already set, which made the rename cost a
	// logged-out CRM and dead lead email for nothing a visitor would see.
	//
	// None of that applies now. This is a different Cloudflare account,
	// created fresh for the new brand: no Worker, no secrets, no deploy
	// history. There is nothing to abandon, so the name may as well be the
	// one that matches the brand from the first deploy rather than carrying
	// the old project's name forever.
	"name": "italy-way-transfers",
	"compatibility_date": "2026-10-29",

	// nodejs_compat is required for one import: lib/quote/idempotency.ts hashes
	// the submission with node:crypto. It also covered @supabase/ssr until that
	// was removed, so this is now a narrower dependency than it looks.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// The production hostname. `custom_domain: true` makes Cloudflare create
	// and own the proxied DNS record for the apex, which is also what puts the
	// request behind Cloudflare Access: the Access application is scoped to
	// `<apex>/crm`, so it can only intercept traffic arriving on this
	// hostname. Access does NOT cover the workers.dev URL, which is why /crm
	// there refuses everyone.
	//
	// One thing must be true on the account before a deploy with this value
	// succeeds: italywaytransfers.com is an active zone here. The Access
	// application is per-hostname and per-account, so it has to be created
	// against this apex on this account — until it is, /crm is reachable by
	// anyone who knows the path.
	"routes": [
		{
			"pattern": "italywaytransfers.com",
			"custom_domain": true
		}
	],

	// Off. It was on temporarily while the custom domain was being proved on
	// the previous account, and is off here from the start.
	//
	// It matters because *.workers.dev publishes the entire public site at a
	// second address: every page canonicals to the apex, so nothing there
	// claims to be the original, but it is still a live URL nobody intended to
	// publish — and one that Cloudflare Access never covers, which is why /crm
	// on it refuses everyone.
	//
	// Turning it off does not touch `routes` above. The custom domain is a
	// separate trigger with its own DNS record, and withdrawing the
	// workers.dev subdomain leaves it untouched.
	"workers_dev": false,

	"services": [
		{
			// Self-reference, used by OpenNext for cache purging. The service name
			// must equal the Worker name above or the deploy fails to resolve it.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "italy-way-transfers"
		}
	],

	// The D1 database on the Italy Way Transfers account. Inspected
	// 19 November 2026: 0 tables, created the same day, so every migration in
	// migrations/ runs against an empty database and 0001 creates rather than
	// alters.
	//
	// The id is what binds, not the name — renaming the database in the
	// dashboard would not break this, but recreating it would.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "italywaytransfers",
			"database_id": "ab7d45d0-6d47-46fa-a74c-f42f75a7e0be"
		}
	]

	// No "images" binding. Cloudflare Images transformations are billable
	// beyond the free allowance and have not been approved, so next/image runs
	// unoptimized instead — see the `images` block in next.config.ts for the
	// trade-off. Add the binding back here, and remove `unoptimized`, to turn
	// optimization on.

	// No R2 bucket and no KV namespace. The incremental cache is served from
	// the Worker's own assets; see open-next.config.ts.
}
